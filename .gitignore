save/trash/
save/activity.txt
save/app.pid
save/stop.flag
save/error.log
save/settings.json
save/_memtest.json

# 自检报告（用了 --out 时才会产生）
reports/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/

# 离线出图是可再生的，不进仓库（需要时跑 tools/render_shots.py）
shots/*.png

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 临时文件 / 提交信息草稿
# 用下划线开头的一律忽略：这类文件都是"过程中"用的，
# 之前 _msg.txt 和 _tmpmsg.txt 都被 git add -A 误提交过两次。
_*
!__init__.py
!__pycache__/
*.bak
*.tmp
